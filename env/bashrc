#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return
export GPG_TTY=$(tty)

HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTIGNORE="ls:ll:la:cd:pwd:exit:clear:history"

bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

bind "set completion-ignore-case on"

export PATH="$PATH:/home/pretzel/.cargo/bin"
export EDITOR=vim
export VISUAL=vim
export BROWSER=firefox
export TERMINAL=kitty
export PAGER='less -R'
export MANPAGER='less -R'
export PATH=$PATH:$HOME/bin/
## Aliases
alias ls='ls --color=auto'
alias ll='ls -l --color=auto'
alias la='ls -la --color=auto'
alias lt='ls --tree --color=auto'
alias l='ls -CF --color=auto'

alias grep='grep --color=auto'

alias mkdir='mkdir -pv'
alias wget='wget -c'
alias df='df -h'
alias du='du -h'
alias free='free -h'
alias neofetch='echo "neofetch does not exist anymore, doofus! use fastfetch" && fastfetch'
## Safety aliases
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

alias vi="vim"

if [ "$TERM" != "dumb" ] && [ -x /usr/bin/tput ]; then
    PS1='\[\e]0;\u@\h: \w\a\]${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='\u@\h:\w\$ '
fi

duo-push() {
	branch=$(git symbolic-ref --short HEAD)
	if ["$branch" = "main" ]; then
	       	git push origin main && git push codeberg main
       	else
		git push origin "$branch"
	fi	       
}



