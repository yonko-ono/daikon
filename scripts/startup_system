#!/bin/bash
set -euo pipefail

BASE="$HOME"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
ENV_DIR="$PROJECT_DIR/env"

DRY_RUN=false
echo $SCRIPT_DIR
# Dry-run implementation, --dry-run triggers it
for arg in "$@"; do
	case "$arg" in
		-n | --dry-run) DRY_RUN=true ;;
		-h | --help)	sed -n '2,4p' "$0"; exit 0 ;;
		*) echo "unknown arg: $arg" >&2; exit 2 ;;
	esac
done

[[ "$DRY_RUN" == true ]] && echo " DRY RUN MODE - No changes will be made"

create_dir() {
	local dir="$1"
	if [[ "$DRY_RUN" == true ]]; then
		echo "[DRY RUN] Would create: $dir"
	else
		mkdir -p "$dir"
		echo " Created: $dir"
	fi
}

set_permission() {
	local path="$1"
	local perms="$2"

	if [[ "$DRY_RUN" == true ]]; then
		echo "[DRY RUN] Would chmod $perms on: $path"
	else
		chmod "$perms" "$path"
		echo " Set $perms on: $path"
	fi
}

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '[DRY RUN] Would run: %s\n' "$*"
    else
        "$@"
    fi
}

warn() { printf '!! %s\n' "$*" >&2; }

create_symlink() {
	local source="$1" target="$2"
	if [[ "$DRY_RUN" == true ]]; then
		echo "[DRY RUN] Would link $source → $target"
	fi
	[[ -L "$target" || -e "$target" ]] && rm -rf -- "$target"
	ln -sfn -- "$source" "$target"
	echo " Linked: $source -> $target"
}
clone_repo() {
    local repo="$1"
    local folder="$2"
    if [[ "$DRY_RUN" == true ]]; then
        echo "[DRY RUN] Would clone $repo to $folder"
    else
        git clone "$repo" "$folder"
        echo " Cloned $repo to $folder"
    fi
}
# Source dirs
# self-explanatory
source $SCRIPT_DIR/folder_structure

echo "[ Step 1: Verifying folder structure ]"

MISSING_DIRS=()
for dir in "${ALL_DIRS[@]}"; do
	if [[ ! -d "$dir" ]]; then
		MISSING_DIRS+=("$dir")
	fi

done

if [[ ${#MISSING_DIRS[@]} -eq 0 ]]; then
	echo "y All folder structures exist"
else
	echo "x One or more folders missing"

	if [[ "$DRY_RUN" == true ]]; then
		echo "[ DRY RUN ] Would create the following directories:"
		for dir in "${MISSING_DIRS[@]}"; do
			echo " - $dir"
		done
	else
	echo " [ Generating folders... ]"

	# Create all missing directories
	for dir in "${MISSING_DIRS[@]}"; do
		create_dir "$dir"
	done

	# Set permissions
	set_permission "$BASE/documents/vault" "700"
	for vault_file in "$BASE/documents/vault"/*; do
		[[ -e "$vault_file" ]] && set_permission "$vault_file" "700"
	done
	set_permission "$BASE/var/tmp" "700"

	echo "y Home structure created"
	fi
fi

echo "[ Step 2: Symlinking HOMEDIR dotfiles ]"

for path in "$ENV_DIR"/*; do
	name="$(basename "$path")"
	[[ "$name" == "config" ]] && continue
	create_symlink "$path" "$HOME/.$name"
done

echo "[ Step 2: Symlinking ~/.config dotfiles ]"
for path in "$ENV_DIR/config"/*; do
	create_symlink "$path" "$HOME/.config/$(basename "$path")"
done

echo "[ Step 3: Dealing with Dependencies.. ]"

DISTRO=""
if [[ -f /etc/os-release ]]; then
	. /etc/os-release
	DISTRO="${ID:-unknown}"
fi

ARCH_PKGS=(
	base-devel libx11 libxinerama libxft freetype2 yajl
	gtk3 gtk4 qt5-base qt6-base qt6ct
	alacritty quickshell
)

DEB_PKGS=(
	build-essential libx11-dev libxinerama-dev libxft-dev libfreetype6-dev libyajl-dev
	libgtk-3-dev libqt5base5-dev
)

install_arch() {
	if command -v paru >/dev/null 2>&1; then
		run paru -S --needed --noconfirm "${ARCH_PKGS[@]}"
	else
		run sudo pacman -S --needed --noconfirm "${ARCH_PKGS[@]}"
	fi
}

case "$DISTRO" in
	arch|artix|endeavouros)
		install_arch
		;;
	*)
		warn "unsupported distro: $DISTRO - install only dotfiles. DWM manual install required."
		warn " arch: ${ARCH_PKGS[*]}"
		;;
esac
